{
  "name": "undertone",
  "version": "0.1.0",
  "description": "Open-source interview and meeting copilot: a capture-proof overlay that listens to both sides of a call, transcribes locally and whispers what to say next.",
  "private": true,
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "lint": "oxlint src",
    "assets": "node scripts/copy-assets.mjs",
    "predev": "npm run assets",
    "prebuild": "npm run assets",
    "dist": "npm run build && electron-builder --win --dir"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.135.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@huggingface/transformers": "^4.3.1",
    "@ricky0123/vad-web": "^0.0.31",
    "electron-log": "^5.4.4",
    "lucide-react": "^1.61.0",
    "onnxruntime-web": "^1.30.0",
    "pdf-parse": "^2.4.5",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electron/fuses": "^2.1.3",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.5",
    "electron": "^44.9.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^6.0.0",
    "jsdom": "^30.1.3",
    "oxlint": "^1.88.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  },
  "build": {
    "appId": "app.undertone.desktop",
    "productName": "Undertone",
    "files": [
      "out/**",
      "package.json"
    ],
    "directories": {
      "output": "dist"
    },
    "asar": true,
    "afterPack": "scripts/after-pack-fuses.cjs",
    "win": {
      "target": [
        "dir"
      ]
    }
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/saintAdrian7/undertone.git"
  },
  "homepage": "https://github.com/saintAdrian7/undertone"
}
